{
  "name": "keepad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A virtual macro pad for macOS and Windows.",
  "author": "KeePad",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env KEEPAD_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build:electron": "node scripts/clean-electron.mjs && tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit -p tsconfig.json && npm run build:electron && vite build",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "npm run build && node tests/desktop.mjs",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --dir",
    "format": "prettier --write src electron shared tests",
    "format:check": "prettier --check src electron shared tests",
    "docs:generate": "node --import tsx scripts/generate-reference.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:screenshots": "npm run build && node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "44.4.3",
    "electron-builder": "^26.8.1",
    "playwright": "^1.58.0",
    "prettier": "^3.9.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "app.keepad.desktop",
    "productName": "KeePad",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true
  }
}
